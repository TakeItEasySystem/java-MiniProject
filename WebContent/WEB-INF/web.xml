<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>WebEase Platform</display-name>
    <description>Professional Websites and Digital Management for Local Businesses</description>

    <!-- Application Lifecycle Listener (Unit III & V) -->
    <listener>
        <listener-class>com.webease.listener.AppContextListener</listener-class>
    </listener>

    <!-- Security Filter: Restricted Founder & Admin Access (Unit III & V Filter API) -->
    <filter>
        <filter-name>AdminAuthFilter</filter-name>
        <filter-class>com.webease.filter.AdminAuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/admin</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminAuthFilter</filter-name>
        <url-pattern>/admin.jsp</url-pattern>
    </filter-mapping>

    <!-- 1. Site & Dashboard Controller Servlet -->
    <servlet>
        <servlet-name>SiteServlet</servlet-name>
        <servlet-class>com.webease.controller.SiteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SiteServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SiteServlet</servlet-name>
        <url-pattern>/sites</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SiteServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
    </servlet-mapping>

    <!-- 2. Maintenance Tickets Servlet -->
    <servlet>
        <servlet-name>TicketServlet</servlet-name>
        <servlet-class>com.webease.controller.TicketServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TicketServlet</servlet-name>
        <url-pattern>/tickets</url-pattern>
    </servlet-mapping>

    <!-- 3. Free Website Health Audit Servlet (AJAX) -->
    <servlet>
        <servlet-name>AuditServlet</servlet-name>
        <servlet-class>com.webease.controller.AuditServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuditServlet</servlet-name>
        <url-pattern>/audit</url-pattern>
    </servlet-mapping>

    <!-- 4. Real-Time Telemetry Ping Servlet (JSON REST endpoint for React 18) -->
    <servlet>
        <servlet-name>HealthPingServlet</servlet-name>
        <servlet-class>com.webease.controller.HealthPingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HealthPingServlet</servlet-name>
        <url-pattern>/ping</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>HealthPingServlet</servlet-name>
        <url-pattern>/health</url-pattern>
    </servlet-mapping>

    <!-- 5. Dynamic Pricing & Quote Calculation Servlet -->
    <servlet>
        <servlet-name>PricingServlet</servlet-name>
        <servlet-class>com.webease.controller.PricingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PricingServlet</servlet-name>
        <url-pattern>/pricing</url-pattern>
    </servlet-mapping>

    <!-- 6. Website Order & Project Build Request Servlet -->
    <servlet>
        <servlet-name>OrderServlet</servlet-name>
        <servlet-class>com.webease.controller.OrderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderServlet</servlet-name>
        <url-pattern>/order</url-pattern>
    </servlet-mapping>

    <!-- 7. Founder & Admin Authentication Controller Servlet -->
    <servlet>
        <servlet-name>AdminAuthServlet</servlet-name>
        <servlet-class>com.webease.controller.AdminAuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminAuthServlet</servlet-name>
        <url-pattern>/admin-auth</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminAuthServlet</servlet-name>
        <url-pattern>/admin-login</url-pattern>
    </servlet-mapping>

    <!-- 8. Verified Customer Account & Portal Authentication Servlet -->
    <servlet>
        <servlet-name>CustomerAuthServlet</servlet-name>
        <servlet-class>com.webease.controller.CustomerAuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerAuthServlet</servlet-name>
        <url-pattern>/customer-auth</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CustomerAuthServlet</servlet-name>
        <url-pattern>/customer-login</url-pattern>
    </servlet-mapping>

    <!-- 9. Dedicated Customer Portal & Profile Hub Servlet -->
    <servlet>
        <servlet-name>CustomerPortalServlet</servlet-name>
        <servlet-class>com.webease.controller.CustomerPortalServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerPortalServlet</servlet-name>
        <url-pattern>/customer-portal</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CustomerPortalServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <!-- Default Welcome File -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session Configuration: 30 minutes inactivity timeout -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
