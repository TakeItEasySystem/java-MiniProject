# ==============================================================================
# WebEase Platform — Jakarta Mail & SMTP Configuration Guide
# ==============================================================================
# You can set these properties via:
# 1. System Environment Variables (Recommended in production):
#    WEBEASE_SMTP_HOST=smtp.gmail.com
#    WEBEASE_SMTP_PORT=587
#    WEBEASE_SMTP_USER=yourbusiness@gmail.com
#    WEBEASE_SMTP_PASS=your-16-char-app-password
#
# 2. Or pass as JVM System Properties in Tomcat (-DWEBEASE_SMTP_USER=...):
#
# For Google Gmail:
# - Host: smtp.gmail.com
# - Port: 587
# - StartTLS: true
# - Username: yourname@gmail.com
# - Password: Use a 16-character Google App Password (NOT your regular Gmail login password)
#   (Generate at: https://myaccount.google.com/apppasswords)
#
# For Brevo (formerly Sendinblue):
# - SMTP Host: smtp-relay.brevo.com
# - SMTP Port: 587
# - User: your-brevo-account-email
# - Pass: your-brevo-smtp-key
#
# For Brevo Transactional SMS (Real Carrier SMS to Mobile Phones):
# - Set BREVO_API_KEY=xkeysib-xxxxxxxxxxxx (Your Brevo API Key v3)
# - Set BREVO_SMS_SENDER=WebEase (Max 11 alphanumeric characters)
# ==============================================================================

WEBEASE_SMTP_HOST=smtp-relay.brevo.com
WEBEASE_SMTP_PORT=587
WEBEASE_SMTP_USER=
WEBEASE_SMTP_PASS=
WEBEASE_SMTP_FROM=support@webease.in
WEBEASE_SMTP_FROM_NAME=WebEase Platform
WEBEASE_SMTP_STARTTLS=true
WEBEASE_SMTP_AUTH=true

# Brevo Transactional SMS Gateway API v3 Key
BREVO_API_KEY=
BREVO_SMS_SENDER=WebEase
